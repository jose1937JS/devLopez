---

<section id="pricing" class="relative py-24 lg:py-32 overflow-hidden">
  <!-- Ambient background glow -->
  <div class="absolute top-0 left-1/2 w-[700px] h-72 rounded-full opacity-[0.05] blur-3xl -translate-x-1/2 -translate-y-1/2" style="background: linear-gradient(90deg, #ff6b26, #f59e0b);" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="reveal flex items-center gap-3 justify-center mb-4">
        <div class="h-px w-12 bg-primary-500/40"></div>
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest text-primary-400">
          <span data-es="Promociones de Lanzamiento" data-en="Launch Promotions">Promociones de Lanzamiento</span>
        </span>
        <div class="h-px w-12 bg-primary-500/40"></div>
      </div>
      
      <h2 class="reveal stagger-1 font-black text-3xl sm:text-4xl lg:text-5xl text-white mb-4 tracking-tight">
        <span data-es="Inversión clara y predecible, " data-en="Transparent, strategic investment,">Inversión clara y predecible, con</span>
        <br />
        <span class="text-gradient" style="background: linear-gradient(135deg, #ff6b26, #f59e0b); background-size: 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
          <span data-es="condiciones preferenciales de lanzamiento." data-en="with special launch promotional rates">condiciones preferenciales <br /> de lanzamiento.</span>
        </span>
      </h2>

      <p
        class="reveal stagger-2 text-base-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed"
        data-es="Desarrollo de software y productos digitales con alcance cerrado y plazos garantizados. Cada proyecto inicia con un anticipo de reserva; el saldo restante se distribuye en dos partes, por hitos aprobados o en cuotas mensuales, adaptándose a la escala y duración del desarrollo."
        data-en="High-end software and digital product development with on-time delivery, clean code, and flexible split payments. All plans include special promotional discounts for our launch season.">
        Desarrollo de software y productos digitales con alcance cerrado y plazos garantizados. Cada proyecto inicia con un anticipo de reserva; el saldo restante se distribuye en dos partes, por hitos aprobados o en cuotas mensuales, adaptándose a la escala y duración del desarrollo.
      </p>

      <!-- Trust Badges -->
      <div class="reveal stagger-3 flex flex-wrap justify-center items-center gap-4 sm:gap-8 mt-6 text-xs text-base-400">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span data-es="Descuentos por lanzamiento" data-en="Launch discounts applied">Descuentos por lanzamiento</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span data-es="Pago inicial y balance por hitos o mensualidades" data-en="Advance payment + milestone/monthly installments">Pago inicial y balance por hitos o mensualidades</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span data-es="Código fuente 100% de tu propiedad" data-en="100% Code ownership">Código fuente 100% de tu propiedad</span>
        </div>
      </div>
    </div>

    <!-- Pricing cards swiper carousel -->
    <div class="swiper pricing-swiper !overflow-visible cursor-grab active:cursor-grabbing select-none">
      <div class="swiper-wrapper items-stretch pt-6 pb-6">
        {plans.map((plan, i) => (
          <div class="swiper-slide !h-auto flex flex-col">
            <div
              class={`pricing-card spotlight-card relative glass rounded-3xl p-6 lg:p-8 flex flex-col h-full border ${plan.color} transition-all duration-300 hover:-translate-y-1.5 ${
                plan.popular ? 'ring-2 ring-primary-500/70 shadow-2xl shadow-primary-500/20 z-10 scale-105' : 'hover:border-primary-500/30'
              }`}
            >
              <!-- Popular badge (positioned to cleanly project above card without clipping) -->
              {plan.popular && (
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 z-30 px-4 py-1.5 rounded-full bg-gradient-to-r from-primary-500 via-orange-500 to-amber-500 text-white text-xs font-black shadow-lg shadow-primary-500/40 whitespace-nowrap flex items-center gap-1.5 border border-white/20 tracking-wider uppercase animate-pulse-glow">
                  <span data-es='Más Popular' data-en='Most Popular'>Más Popular</span>
                </div>
              )}

              <!-- Plan header -->
              <div class="mb-6">
                <h3 class="font-bold text-white text-xl mb-1.5" data-es={plan.nameEs} data-en={plan.nameEn}>
                  {plan.nameEs}
                </h3>
                <p class="text-sm text-base-400 mb-4 min-h-[42px] leading-relaxed" data-es={plan.descEs} data-en={plan.descEn}>
                  {plan.descEs}
                </p>

                <!-- Price container -->
                <div class="pt-2 border-t border-white/5">
                  {plan.haveStartingPrice && (
                    <span class="block text-xs font-bold uppercase tracking-wider text-primary-400 mb-1" data-es="Desde" data-en="Starting At">
                      Desde
                    </span>
                  )}

                  {!plan.haveStartingPrice && plan.priceUSD && (
                    <span class="block text-xs font-bold uppercase tracking-wider text-primary-400 mb-1" data-es="Desde" data-en="Starting At">
                      Precio Unico
                    </span>
                  )}

                  {plan.priceUSD ? (
                    <div class="flex items-baseline gap-2.5 flex-wrap">
                      <span class="text-4xl lg:text-5xl font-black text-white tracking-tight">{plan.priceUSD}</span>
                      {plan.originalPriceUSD && (
                        <span class="text-lg lg:text-xl font-bold text-base-400 line-through decoration-primary-500 decoration-2">
                          {plan.originalPriceUSD}
                        </span>
                      )}
                    </div>
                  ) : (
                    <div class="flex items-baseline gap-2.5 flex-wrap">
                      <span class="text-3xl lg:text-4xl font-black text-white tracking-tight" data-es="A Medida" data-en="Custom">
                        A Medida
                      </span>
                    </div>
                  )}
                </div>
              </div>

              <!-- Divider -->
              <div class="mb-6 flex flex-row">
                <p
                  class="text-base-400 text-xs mr-3"
                  data-es="Caracteristicas"
                  data-en="Features"
                >Caracteristicas</p>
                <div class="h-px bg-white/8 w-full my-auto"></div>
              </div>

              <!-- Features -->
              <ul class="flex flex-col gap-2.5 flex-1 mb-8">
                {plan.featuresEs.map((f, fi) => (
                  <li class="flex items-start gap-2.5 text-sm text-base-300">
                    <svg class="w-4 h-4 text-primary-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span data-es={f} data-en={plan.featuresEn[fi]}>{f}</span>
                  </li>
                ))}
              </ul>

              <!-- CTA -->
              <a
                href="#contact"
                class={`btn-magnetic w-full text-center py-3.5 rounded-xl font-bold text-sm tracking-wide transition-all duration-200 ${
                  plan.popular
                    ? 'bg-primary-500 hover:bg-primary-400 text-white glow-primary-sm hover:glow-primary shadow-lg shadow-primary-500/25'
                    : 'bg-white/5 hover:bg-primary-500 text-white hover:text-white border border-white/10 hover:border-primary-500 transition-all'
                }`}
                data-es={plan.ctaEs}
                data-en={plan.ctaEn}
              >
                {plan.ctaEs}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Note -->
    <p
      class="reveal text-center text-sm text-base-300 mt-12 max-w-2xl mx-auto animate-bounce-subtle "
      data-es="Arrastra las tarjetas hacia la izquierda para ver más planes →"
      data-en="Drag the cards to the left to see more plans →"
    >
      Arrastra las tarjetas hacia la izquierda para ver más planes →
    </p>
  </div>
</section>

<style>
  .pricing-swiper {
    overflow: visible !important;
  }
  .pricing-swiper :global(.swiper-wrapper) {
    display: flex;
    align-items: stretch;
  }
  .pricing-swiper :global(.swiper-slide) {
    height: auto !important;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: 25rem !important;
    max-width: 85vw !important;
  }
  .pricing-card {
    overflow: visible !important;
  }
  .pricing-card::before {
    border-radius: 1.5rem;
  }
</style>

<script>
  import Swiper from 'swiper';
  import { FreeMode, Mousewheel } from 'swiper/modules';

  function initPricingSwiper() {
    const el = document.querySelector<HTMLElement>('.pricing-swiper');
    if (!el || el.dataset.swiperInitialized === 'true') return;

    new Swiper('.pricing-swiper', {
      modules: [FreeMode, Mousewheel],
      slidesPerView: 'auto',
      spaceBetween: 20,
      freeMode: {
        enabled: true,
        sticky: false,
        momentum: true,
        momentumBounce: true,
      },
      mousewheel: {
        forceToAxis: true,
        releaseOnEdges: true,
      },
      grabCursor: true,
      breakpoints: {
        768: {
          spaceBetween: 24,
        },
        1024: {
          spaceBetween: 30,
        },
      },
    });

    el.dataset.swiperInitialized = 'true';
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPricingSwiper);
  } else {
    initPricingSwiper();
  }
  document.addEventListener('astro:page-load', initPricingSwiper);
</script>
