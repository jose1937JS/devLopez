---
// Navbar.astro — Fixed frosted-glass navigation with i18n + theme toggle
import Logo from './Logo.astro';
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-[100] transition-all duration-300"
>
  <div
    class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
  >
    <nav class="flex items-center justify-between h-18">
      <!-- Logo -->
      <Logo />

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-1">
        {[
          { href: '/#about', es: 'Nosotros', en: 'About' },
          { href: '/#services', es: 'Servicios', en: 'Services' },
          { href: '/#portfolio', es: 'Portafolio', en: 'Portfolio' },
          { href: '/#pricing', es: 'Precios', en: 'Pricing' },
          { href: '/#faq', es: 'FAQ', en: 'FAQ' },
        ].map((link) => (
          <a
            href={link.href}
            data-es={link.es}
            data-en={link.en}
            class="px-3.5 py-2 text-sm font-medium text-base-300 hover:text-white dark:hover:text-white transition-colors duration-200 rounded-lg hover:bg-white/5"
          >
            {link.es}
          </a>
        ))}
      </div>

      <!-- Right Controls -->
      <div class="flex items-center gap-2">
        <!-- Lang Toggle -->
        <button
          id="lang-toggle"
          class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-base-300 hover:text-white border border-white/10 hover:border-white/20 transition-all duration-200 glass"
          aria-label="Toggle language"
        >
          <span id="lang-label">ES</span>
          <svg class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
        </button>

        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          class="w-9 h-9 rounded-lg glass hover:bg-white/8 flex items-center justify-center text-base-300 hover:text-white transition-all duration-200"
          aria-label="Toggle theme"
        >
          <!-- Sun icon -->
          <svg id="icon-sun" class="w-4.5 h-4.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon icon -->
          <svg id="icon-moon" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- CTA Button -->
        <a
          href="/#contact"
          data-es="Cotizar Proyecto"
          data-en="Get a Quote"
          class="btn-magnetic hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary-500 hover:bg-primary-600 text-white text-sm font-semibold transition-all duration-200 glow-primary-sm hover:glow-primary"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Cotizar Proyecto
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden w-9 h-9 rounded-lg glass flex items-center justify-center text-base-300"
          aria-label="Open menu"
        >
          <svg id="menu-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden glass border-t border-white/5 px-4 py-4"
  >
    <div class="flex flex-col gap-1">
      {[
        { href: '/#about', es: 'Nosotros', en: 'About' },
        { href: '/#services', es: 'Servicios', en: 'Services' },
        { href: '/#portfolio', es: 'Portafolio', en: 'Portfolio' },
        { href: '/#pricing', es: 'Precios', en: 'Pricing' },
        { href: '/#faq', es: 'FAQ', en: 'FAQ' },
      ].map((link) => (
        <a
          href={link.href}
          data-es={link.es}
          data-en={link.en}
          class="mobile-nav-link px-4 py-2.5 rounded-lg text-sm font-medium text-base-300 hover:text-white hover:bg-white/5 transition-all"
        >
          {link.es}
        </a>
      ))}
      <a
        href="/#contact"
        data-es="Cotizar Proyecto"
        data-en="Get a Quote"
        class="mt-2 px-4 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold text-center"
      >
        Cotizar Proyecto
      </a>
    </div>
  </div>
</header>

<script is:inline>
  // Navbar scroll effect
  const navbar = document.getElementById('navbar');
  let scrolled = false;

  window.addEventListener('scroll', () => {
    const isScrolled = window.scrollY > 20;
    if (isScrolled !== scrolled) {
      scrolled = isScrolled;
      if (scrolled) {
        navbar.classList.add('bg-white/85', 'dark:bg-base-900/80', 'backdrop-blur-md', 'border-b', 'border-black/5', 'dark:border-white/5', 'shadow-sm');
      } else {
        navbar.classList.remove('bg-white/85', 'dark:bg-base-900/80', 'backdrop-blur-md', 'border-b', 'border-black/5', 'dark:border-white/5', 'shadow-sm');
      }
    }
  });

  // Mobile menu
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpen = document.getElementById('menu-open');
  const menuClose = document.getElementById('menu-close');

  menuBtn?.addEventListener('click', () => {
    const open = mobileMenu.classList.toggle('hidden');
    menuOpen.classList.toggle('hidden', !open);
    menuClose.classList.toggle('hidden', open);
  });

  // Close mobile on link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuOpen.classList.remove('hidden');
      menuClose.classList.add('hidden');
    });
  });

  // Theme toggle
  const themeBtn = document.getElementById('theme-toggle');
  const iconSun = document.getElementById('icon-sun');
  const iconMoon = document.getElementById('icon-moon');

  function syncThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    iconSun.classList.toggle('hidden', !isDark);
    iconMoon.classList.toggle('hidden', isDark);
  }

  syncThemeIcons();

  themeBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    syncThemeIcons();
  });

  // Language toggle
  const langBtn = document.getElementById('lang-toggle');
  const langLabel = document.getElementById('lang-label');

  langBtn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-lang') || 'es';
    const next = current === 'es' ? 'en' : 'es';
    langLabel.textContent = next.toUpperCase();
    if (window.__setLang) window.__setLang(next);
  });

  // Sync label on load
  const currentLang = document.documentElement.getAttribute('data-lang') || 'es';
  if (langLabel) langLabel.textContent = currentLang.toUpperCase();
</script>
