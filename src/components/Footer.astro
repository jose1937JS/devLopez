  { es: 'Software a Medida', en: 'Custom Software' },
  { es: 'Apps iOS & Android', en: 'iOS & Android Apps' },
  { es: 'Páginas Web', en: 'Websites' },
  { es: 'Landing Pages', en: 'Landing Pages' },
  { es: 'SaaS / MVP', en: 'SaaS / MVP' },
  { es: 'Consultoría Técnica', en: 'Technical Consulting' },
