---

<footer class="sticky bottom-0 -z-10 border-t border-white/5 overflow-hidden">
  <!-- Top glow -->
  <div class="absolute top-0 left-1/2 w-[800px] h-px -translate-x-1/2 bg-gradient-to-r from-transparent via-primary-500/30 to-transparent" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Main footer content -->
    <div class="py-16 grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Brand column -->
      <div class="col-span-2 md:col-span-1">
        <a href="#hero" class="flex items-center gap-2.5 mb-4 group">
          <div class="w-9 h-9 rounded-xl bg-primary-500 flex items-center justify-center text-white font-bold text-lg">D</div>
          <span class="font-bold text-xl tracking-tight text-white">Dev<span class="text-primary-500">Lopez</span></span>
        </a>
        <p class="text-sm text-base-400 leading-relaxed mb-5" data-es="Transformamos ideas en productos digitales de alto impacto." data-en="We transform ideas into high-impact digital products.">
          Transformamos ideas en productos digitales de alto impacto.
        </p>
        <!-- Socials -->
        <div class="flex gap-2">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.name}
              class="w-9 h-9 rounded-lg glass hover:bg-primary-500/20 hover:border-primary-500/30 flex items-center justify-center text-base-400 hover:text-white transition-all duration-200 border border-white/5"
            >
              <Fragment set:html={s.icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-base-500 mb-4" data-es="Navegación" data-en="Navigation">Navegación</h4>
        <ul class="flex flex-col gap-2">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                data-es={link.es}
                data-en={link.en}
                class="text-sm text-base-400 hover:text-white transition-colors duration-200"
              >
                {link.es}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-base-500 mb-4" data-es="Servicios" data-en="Services">Servicios</h4>
        <ul class="flex flex-col gap-2">
          {services.map((s) => (
            <li>
              <a
                href="#services"
                data-es={s.es}
                data-en={s.en}
                class="text-sm text-base-400 hover:text-white transition-colors duration-200"
              >
                {s.es}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact info -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-base-500 mb-4" data-es="Contacto Rápido" data-en="Quick Contact">Contacto Rápido</h4>
        <ul class="flex flex-col gap-3">
          <li>
            <a href="mailto:hola@devlopez.dev" class="text-sm text-base-400 hover:text-primary-400 transition-colors duration-200 flex items-center gap-2">
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              hola@devlopez.dev
            </a>
          </li>
          <li>
            <a href="https://wa.me/+584120345008" class="text-sm text-base-400 hover:text-primary-400 transition-colors duration-200 flex items-center gap-2">
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              +1 (555) 123-4567
            </a>
          </li>
          <li>
            <a
              href="#contact"
              class="btn-magnetic inline-flex items-center gap-1.5 mt-2 px-4 py-2 rounded-xl bg-primary-500 hover:bg-primary-400 text-white text-xs font-semibold transition-all"
            >
              <span data-es="Cotizar Proyecto" data-en="Get a Quote">Cotizar Proyecto</span>
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/5 py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-base-500">
      <p>
        © {currentYear} DevLopez Studio. <span data-es="Todos los derechos reservados." data-en="All rights reserved.">Todos los derechos reservados.</span>
      </p>
      <div class="flex items-center gap-4">
        <a href="/privacy" class="hover:text-white transition-colors" data-es="Política de Privacidad" data-en="Privacy Policy">Política de Privacidad</a>
        <span class="opacity-30">·</span>
        <a href="/terms" class="hover:text-white transition-colors" data-es="Términos de Uso" data-en="Terms of Use">Términos de Uso</a>
        <span class="opacity-30">·</span>
        <span data-es="Hecho con" data-en="Made with">Hecho con</span>
        <span class="text-primary-500">♥</span>
        <span>Astro + Tailwind</span>
      </div>
    </div>
  </div>
</footer>
