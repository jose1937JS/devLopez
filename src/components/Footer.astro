  { href: '#portfolio', es: 'Portafolio', en: 'Portfolio' },
  { href: '#pricing', es: 'Precios', en: 'Pricing' },
  { href: '#faq', es: 'FAQ', en: 'FAQ' },
  { href: '#contact', es: 'Contacto', en: 'Contact' },
