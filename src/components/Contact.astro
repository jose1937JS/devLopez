---
// Contact.astro — Modern validated form with WhatsApp / Email quick links + parallax
---

<section
  id="contact"
  class="relative py-24 lg:py-32 overflow-hidden bg-[#f8f9fa] dark:bg-[#0a0a0c] transition-colors duration-300"
  style="background-image: radial-gradient(ellipse 80% 60% at 50% 100%, rgba(255,107,38,0.08) 0%, transparent 60%);"
>
  <!-- Parallax bg element -->
  <div
    id="contact-parallax"
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 60% 40% at 50% 110%, rgba(255,107,38,0.12), transparent); transition: transform 0.4s ease;"
  ></div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
      <!-- Left: Info -->
      <div class="flex flex-col gap-8">
        <div>
          <div class="reveal flex items-center gap-3 mb-4">
            <div class="h-px w-12 bg-primary-500/40"></div>
            <span class="text-xs font-semibold uppercase tracking-widest text-primary-500" data-es="Contacto" data-en="Contact">Contacto</span>
          </div>
          <h2 class="reveal stagger-1 font-black text-3xl sm:text-4xl lg:text-5xl text-white mb-4 leading-tight">
            <span data-es="¿Listo para" data-en="Ready to">¿Listo para</span>
            <br />
            <span
              class="text-gradient"
              style="background: linear-gradient(135deg, #ff6b26, #f59e0b); background-size:200%; -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">
              <span data-es="llevar tu proyecto a producción?" data-en="bring your project to production?">llevar tu proyecto a producción?</span>
            </span>
          </h2>
          <p
            class="reveal stagger-2 text-base-300 text-lg leading-relaxed"
            data-es="Cuéntame de qué trata tu idea o qué requerimientos técnicos tiene tu plataforma. Analizo la viabilidad de tu software y te respondo en menos de 24 horas hábiles con una estimación preliminar sin costo ni compromiso."
            data-en="Tell me about your idea or the technical requirements of your platform. I'll analyze your software's viability and get back to you within 24 business hours with a no-cost, no-obligation preliminary estimate.">
            Cuéntame de qué trata tu idea o qué requerimientos técnicos tiene tu plataforma. Analizo la viabilidad de tu software y te respondo en menos de 24 horas hábiles con una estimación preliminar sin costo ni compromiso.
          </p>
        </div>

        <!-- Next steps / Workflow -->
        <div class="reveal stagger-3 flex flex-col gap-4 pt-1">
          <h3
            class="text-sm font-bold uppercase tracking-wider text-primary-400 flex items-center gap-2"
            data-es="¿Qué pasa después de enviar tu mensaje?"
            data-en="What happens after sending your message?"
          >
            <span data-es="¿Qué pasa después de enviar tu mensaje?" data-en="What happens after sending your message?">¿Qué pasa después de enviar tu mensaje?</span>
          </h3>
          <ol class="space-y-3.5">
            <li class="flex items-start gap-3.5 p-4 rounded-2xl glass border border-white/5 bg-white/[0.02]">
              <div class="flex-shrink-0 flex items-center justify-center w-7 h-7 rounded-xl bg-primary-500/10 border border-primary-500/30 text-primary-400 font-bold text-xs">
                1
              </div>
              <div>
                <h4
                  class="text-sm font-semibold text-white mb-1"
                  data-es="Análisis técnico preliminar"
                  data-en="Preliminary technical analysis"
                >
                  Análisis técnico preliminar
                </h4>
                <p
                  class="text-xs text-base-300 leading-relaxed"
                  data-es="Evalúo el alcance de tu proyecto, las tecnologías idóneas (web, móvil o backend) y el esquema de arquitectura necesario."
                  data-en="I evaluate the scope of your project, suitable technologies (web, mobile, or backend), and the necessary architecture."
                >
                  Evalúo el alcance de tu proyecto, las tecnologías idóneas (web, móvil o backend) y el esquema de arquitectura necesario.
                </p>
              </div>
            </li>

            <li class="flex items-start gap-3.5 p-4 rounded-2xl glass border border-white/5 bg-white/[0.02]">
              <div class="flex-shrink-0 flex items-center justify-center w-7 h-7 rounded-xl bg-primary-500/10 border border-primary-500/30 text-primary-400 font-bold text-xs">
                2
              </div>
              <div>
                <h4
                  class="text-sm font-semibold text-white mb-1"
                  data-es="Propuesta clara y presupuesto cerrado"
                  data-en="Clear proposal and fixed quote"
                >
                  Propuesta clara y presupuesto cerrado
                </h4>
                <p
                  class="text-xs text-base-300 leading-relaxed"
                  data-es="Recibes una estimación con tiempos de entrega, desglose de funcionalidades y un plan de pagos por hitos."
                  data-en="You receive an estimate with estimated delivery times, feature breakdown, and a payment plan by milestones."
                >
                  Recibes una estimación con tiempos de entrega, desglose de funcionalidades y un plan de pagos por hitos.
                </p>
              </div>
            </li>

            <li class="flex items-start gap-3.5 p-4 rounded-2xl glass border border-white/5 bg-white/[0.02]">
              <div class="flex-shrink-0 flex items-center justify-center w-7 h-7 rounded-xl bg-primary-500/10 border border-primary-500/30 text-primary-400 font-bold text-xs">
                3
              </div>
              <div>
                <h4
                  class="text-sm font-semibold text-white mb-1"
                  data-es="Trato 1 a 1 de principio a fin"
                  data-en="1-on-1 collaboration from start to finish"
                >
                  Trato 1 a 1 de principio a fin
                </h4>
                <p
                  class="text-xs text-base-300 leading-relaxed"
                  data-es="Sin intermediarios ni vendedores. Hablas directamente con quien va a escribir, desplegar y mantener tu código."
                  data-en="No middlemen or salespeople. You speak directly with the person who will write, deploy, and maintain your code."
                >
                  Sin intermediarios ni vendedores. Hablas directamente con quien va a escribir, desplegar y mantener tu código.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="reveal stagger-2 mt-12">
        <form
          id="contact-form"
          class="glass rounded-3xl p-6 sm:p-8 border border-white/8 flex flex-col gap-5"
          novalidate
        >
          <!-- Name + Email -->
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label for="name" class="text-xs font-semibold uppercase tracking-wide text-base-400" data-es="Nombre *" data-en="Name *">Nombre *</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                placeholder="Tu nombre"
                class="form-input w-full px-4 py-3 rounded-xl glass border border-white/10 focus:border-primary-500/50 focus:outline-none text-white placeholder-base-500 text-sm transition-all duration-200 bg-white/3"
              />
              <span class="form-error text-xs text-red-400 hidden" data-field="name"></span>
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="email" class="text-xs font-semibold uppercase tracking-wide text-base-400" data-es="Email *" data-en="Email *">Email *</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder="tu@email.com"
                class="form-input w-full px-4 py-3 rounded-xl glass border border-white/10 focus:border-primary-500/50 focus:outline-none text-white placeholder-base-500 text-sm transition-all duration-200 bg-white/3"
              />
              <span class="form-error text-xs text-red-400 hidden" data-field="email"></span>
            </div>
          </div>

          <!-- Project type -->
          <div class="flex flex-col gap-1.5">
            <label for="project-type" class="text-xs font-semibold uppercase tracking-wide text-base-400" data-es="Tipo de Proyecto *" data-en="Project Type *">Tipo de Proyecto *</label>
            <select
              id="project-type"
              name="project_type"
              required
              class="form-input w-full px-4 py-3 rounded-xl glass border border-white/10 focus:border-primary-500/50 focus:outline-none text-white text-sm transition-all duration-200 bg-base-800 appearance-none"
            >
              <option value="" class="bg-base-800" data-es="Selecciona una opción" data-en="Select an option">Selecciona una opción</option>
              <option value="landing" class="bg-base-800" data-es="Landing Page" data-en="Landing Page">Landing Page</option>
              <option value="website" class="bg-base-800" data-es="Sitio Web" data-en="Website">Sitio Web</option>
              <option value="webapp" class="bg-base-800" data-es="Web App / SaaS / MVP" data-en="Web App / SaaS / MVP">Web App / SaaS / MVP</option>
              <option value="ecommerce" class="bg-base-800" data-es="E-commerce / Tienda Online" data-en="E-commerce / Online Store">E-commerce / Tienda Online</option>
              <option value="mobile" class="bg-base-800" data-es="App Móvil iOS / Android" data-en="Mobile App iOS / Android">App Móvil iOS / Android</option>
              <option value="other" class="bg-base-800" data-es="Otro" data-en="Other">Otro</option>
            </select>
            <span class="form-error text-xs text-red-400 hidden" data-field="project_type"></span>
          </div>

          <!-- Budget -->
          <div class="flex flex-col gap-1.5">
            <label for="budget" class="text-xs font-semibold uppercase tracking-wide text-base-400" data-es="Presupuesto Estimado" data-en="Estimated Budget">Presupuesto Estimado</label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="budget-options" role="group">
              {[
                { val: '$100-$500', label: '$100 - $500' },
                { val: '$500-$1K', label: '$500 - $1K' },
                { val: '$1K-$2K', label: '$1K - $2K' },
                { val: '$2K-$5K+', label: '$2K - $5K+' },
              ].map((opt) => (
                <label class="budget-option cursor-pointer relative">
                  <input type="radio" name="budget" value={opt.val} class="sr-only peer" />
                  <span class="budget-label block text-center px-3 py-2 rounded-xl text-xs font-semibold glass border border-white/10 text-base-300 hover:text-white hover:border-primary-500/40 peer-checked:bg-primary-500 peer-checked:text-white peer-checked:border-primary-500 transition-all duration-200">
                    {opt.label}
                  </span>
                </label>
              ))}
            </div>
          </div>

          <!-- Deadline -->
          <div class="flex flex-col gap-1.5">
            <label for="deadline" class="text-xs font-semibold uppercase tracking-wide text-base-400" data-es="Tiempo de entrega deseado" data-en="Desired Delivery Time">Tiempo de entrega deseado</label>
            <select
              id="deadline"
              name="deadline"
              required
              class="form-input w-full px-4 py-3 rounded-xl glass border border-white/10 focus:border-primary-500/50 focus:outline-none text-white text-sm transition-all duration-200 bg-white/3"
            >
              <option value="" selected disabled class="bg-base-800">Selecciona una opción</option>
              <option value="ASAP" class="bg-base-800" data-es="Lo antes posible (ASAP)" data-en="As soon as possible (ASAP)">Lo antes posible (ASAP)</option>
              <option value="1-2-semanas" class="bg-base-800" data-es="1-2 semanas" data-en="1-2 weeks">1-2 semanas</option>
              <option value="2-4-semanas" class="bg-base-800" data-es="2-4 semanas" data-en="2-4 weeks">2-4 semanas</option>
              <option value="1-2-meses" class="bg-base-800" data-es="1-2 meses" data-en="1-2 months">1-2 meses</option>
              <option value="mas-2-meses" class="bg-base-800" data-es="Más de 2 meses" data-en="More than 2 months">Más de 2 meses</option>
            </select>
            <span class="form-error text-xs text-red-400 hidden" data-field="deadline"></span>
          </div>

          <!-- Message -->
          <div class="flex flex-col gap-1.5">
            <label for="message" class="text-xs font-semibold uppercase tracking-wide text-base-400" data-es="Cuéntanos tu proyecto *" data-en="Tell us about your project *">Cuéntanos tu proyecto *</label>
            <textarea
              id="message"
              name="message"
              required
              rows="4"
              placeholder="Describe brevemente tu idea, objetivos y cualquier detalle relevante..."
              class="form-input w-full px-4 py-3 rounded-xl glass border border-white/10 focus:border-primary-500/50 focus:outline-none text-white placeholder-base-500 text-sm transition-all duration-200 bg-white/3 resize-none"
            ></textarea>
            <span class="form-error text-xs text-red-400 hidden" data-field="message"></span>
          </div>

          <!-- WhatsApp proposal checkbox & conditional phone input -->
          <div class="flex flex-col gap-3">
            <div class="flex items-center gap-3">
              <input
                type="checkbox"
                id="whatsapp-toggle"
                name="whatsapp_opt_in"
                class="w-4 h-4 rounded border-white/20 bg-white/5 text-primary-500 focus:ring-primary-500/30 focus:ring-offset-0 cursor-pointer accent-[#ff6b26]"
              />
              <label
                for="whatsapp-toggle"
                class="text-xs sm:text-sm text-base-300 hover:text-white transition-colors cursor-pointer select-none"
                data-es="Me gustaría que me enviaran la propuesta también al whatsapp"
                data-en="I would like to receive the proposal also on WhatsApp"
              >
                Me gustaría que me enviaran la propuesta también al whatsapp
              </label>
            </div>

            <div id="whatsapp-container" class="hidden flex-col gap-1.5 transition-all duration-300">
              <label
                for="whatsapp-phone"
                class="text-xs font-semibold uppercase tracking-wide text-base-400"
                data-es="Número de teléfono (con código de país) *"
                data-en="Phone number (with country code) *"
              >
                Número de teléfono (con código de país) *
              </label>
              <input
                id="whatsapp-phone"
                name="whatsapp_phone"
                type="tel"
                placeholder="ej: +584121234567"
                class="form-input w-full px-4 py-3 rounded-xl glass border border-white/10 focus:border-primary-500/50 focus:outline-none text-white placeholder-base-500 text-sm transition-all duration-200 bg-white/3"
              />
              <span class="form-error text-xs text-red-400 hidden" data-field="whatsapp_phone"></span>
            </div>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            id="submit-btn"
            class="btn-magnetic group w-full flex items-center justify-center gap-2.5 py-4 rounded-2xl bg-primary-500 hover:bg-primary-400 text-white font-bold text-base transition-all duration-200 glow-primary-sm hover:glow-primary cursor-pointer"
          >
            <svg class="w-5 h-5 group-hover:rotate-12 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span id="submit-text" data-es="Enviar Propuesta" data-en="Send Proposal">Enviar Propuesta</span>
          </button>

          <!-- Success message -->
          <div id="form-success" class="hidden text-center py-4 px-6 rounded-xl bg-green-500/10 border border-green-500/20 text-green-400 text-sm font-semibold">
            <span data-es="✅ ¡Mensaje enviado! Te contactaremos en menos de 24 horas." data-en="✅ Message sent! We'll contact you in less than 24 hours.">
              ✅ ¡Mensaje enviado! Te contactaremos en menos de 24 horas.
            </span>
          </div>

          <!-- Error message -->
          <div id="form-error-alert" class="hidden text-center py-4 px-6 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm font-semibold">
            <span data-es="❌ Error al enviar el mensaje. Por favor intenta de nuevo o escríbeme directamente." data-en="❌ Error sending message. Please try again or write to me directly.">
              ❌ Error al enviar el mensaje. Por favor intenta de nuevo o escríbeme directamente.
            </span>
          </div>

          <p class="text-xs text-base-300 text-center" data-es="No guardamos tu información personal ni enviamos correos no deseados." data-en="We do not store your personal information or send unwanted emails.">
            No guardamos tu información personal ni enviamos correos no deseados.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .budget-option input:checked + .budget-label,
  .budget-label.active-budget {
    background-color: var(--color-primary-500, #ff6b26) !important;
    color: #ffffff !important;
    border-color: var(--color-primary-500, #ff6b26) !important;
  }
</style>

<script>
  import emailjs from '@emailjs/browser';

  const EMAILJS_SERVICE_ID  = 'service_nkj3uwb';
  const EMAILJS_TEMPLATE_ID = 'template_f7kpqnk';
  const EMAILJS_PUBLIC_KEY  = 'r8EzIy-QpZr2b6mXe';

  // Contact parallax
  const contactSection = document.getElementById('contact');
  const parallaxEl = document.getElementById('contact-parallax');

  if (contactSection && parallaxEl) {
    window.addEventListener('scroll', () => {
      const rect = contactSection.getBoundingClientRect();
      const viewH = window.innerHeight;
      if (rect.top < viewH && rect.bottom > 0) {
        const progress = (viewH - rect.top) / (viewH + rect.height);
        parallaxEl.style.transform = `translateY(${progress * 30 - 15}px)`;
      }
    }, { passive: true });
  }

  // Budget radio visual
  const budgetRadios = document.querySelectorAll<HTMLInputElement>('.budget-option input[type="radio"]');
  budgetRadios.forEach((radio) => {
    radio.addEventListener('change', () => {
      document.querySelectorAll('.budget-label').forEach((l) => {
        l.classList.remove('active-budget');
      });
      if (radio.checked) {
        radio.nextElementSibling?.classList.add('active-budget');
      }
    });
  });

  // Form validation + submission
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitText = document.getElementById('submit-text');
  const successMsg = document.getElementById('form-success');
  const errorAlert = document.getElementById('form-error-alert');
  const whatsappToggle = document.getElementById('whatsapp-toggle') as HTMLInputElement | null;
  const whatsappContainer = document.getElementById('whatsapp-container');
  const whatsappPhoneInput = document.getElementById('whatsapp-phone') as HTMLInputElement | null;

  whatsappToggle?.addEventListener('change', () => {
    if (whatsappToggle.checked) {
      whatsappContainer?.classList.remove('hidden');
      whatsappContainer?.classList.add('flex');
      whatsappPhoneInput?.focus();
    } else {
      whatsappContainer?.classList.add('hidden');
      whatsappContainer?.classList.remove('flex');
      const err = form?.querySelector<HTMLElement>('[data-field="whatsapp_phone"]');
      if (err) {
        err.textContent = '';
        err.classList.add('hidden');
      }
      whatsappPhoneInput?.classList.remove('border-red-500/50');
    }
  });

  function showError(field: string, msg: string) {
    const el = form?.querySelector<HTMLElement>(`[data-field="${field}"]`);
    if (el) { el.textContent = msg; el.classList.remove('hidden'); }
    const input = form?.querySelector<HTMLElement>(`[name="${field}"]`);
    input?.classList.add('border-red-500/50');
  }

  function clearErrors() {
    form?.querySelectorAll('.form-error').forEach((el) => { el.textContent = ''; el.classList.add('hidden'); });
    form?.querySelectorAll('.form-input').forEach((el) => el.classList.remove('border-red-500/50'));
    errorAlert?.classList.add('hidden');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    const formData = new FormData(form);
    const data = Object.fromEntries(formData) as Record<string, string>;
    let valid = true;

    if (!data.name?.trim()) { showError('name', 'El nombre es requerido.'); valid = false; }
    if (!data.email?.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) { showError('email', 'Ingresa un email válido.'); valid = false; }
    if (!data.project_type) { showError('project_type', 'Selecciona un tipo de proyecto.'); valid = false; }
    if (!data.message?.trim() || data.message.length < 10) { showError('message', 'El mensaje debe tener al menos 10 caracteres.'); valid = false; }
    if (!data.budget) { showError('budget', 'Selecciona un presupuesto.'); valid = false; }

    const isWhatsappChecked = Boolean(whatsappToggle?.checked);
    if (isWhatsappChecked) {
      const phone = (data.whatsapp_phone || '').trim();
      const phoneClean = phone.replace(/[\s\-\(\)]/g, '');
      if (!phone) {
        showError('whatsapp_phone', 'El número de teléfono es obligatorio.');
        valid = false;
      } else if (!/^\+[1-9]\d{7,14}$/.test(phoneClean)) {
        showError('whatsapp_phone', 'Ingresa un número válido con código de país (ej: +584121111111).');
        valid = false;
      }
    }

    if (!valid) return;

    // Loading state
    const origHTML = submitBtn?.innerHTML ?? '';
    if (submitBtn) {
      submitBtn.disabled = true;
      if (submitText) submitText.textContent = 'Enviando...';
    }

    const now = new Date();
    const timeStr = now.toLocaleString('es-VE', {
      timeZone: 'America/Caracas',
      year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', second: '2-digit',
      hour12: false,
    });

    const projectLabels: Record<string, string> = {
      landing: 'Landing Page',
      website: 'Sitio Web',
      webapp: 'Web App / SaaS / MVP',
      ecommerce: 'E-commerce / Tienda Online',
      mobile: 'App Móvil iOS / Android',
      other: 'Otro',
    };

    const projectTypeReadable = projectLabels[data.project_type] || data.project_type || 'N/A';
    const whatsappPhone = isWhatsappChecked ? (data.whatsapp_phone?.trim() || '') : '';

    const payload: Record<string, string|boolean> = {
      name: data.name.trim(),
      time: timeStr,
      email: data.email.trim(),
      subject: projectTypeReadable,
      message: data.message.trim(),
      budget: data.budget || 'No especificado',
      deadline: data.deadline || 'A coordinar',
      appType: projectTypeReadable,
      whatsapp: isWhatsappChecked,
      phone: whatsappPhone || 'No solicitado',
    };

    try {
      await emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, payload, {
        publicKey: EMAILJS_PUBLIC_KEY,
      });

      form.reset();
      whatsappContainer?.classList.add('hidden');
      whatsappContainer?.classList.remove('flex');
      document.querySelectorAll('.budget-label').forEach((l) => l.classList.remove('active-budget'));
      successMsg?.classList.remove('hidden');
      setTimeout(() => successMsg?.classList.add('hidden'), 8000);
    } catch (err) {
      console.error('[EmailJS] send error:', err);
      errorAlert?.classList.remove('hidden');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = origHTML;
      }
    }
  });
</script>
