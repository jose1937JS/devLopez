---
// Services.astro — Interactive tab-based service grid
const services = [
  {
    id: 'software',
    iconEs: 'Software a Medida',
    iconEn: 'Custom Software',
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
    titleEs: 'Software a Medida & Backend',
    titleEn: 'Custom Software & Backend',
    descEs: 'Diseño y construyo arquitecturas en la nube, plataformas SaaS y APIs de alto rendimiento preparadas para operar con estabilidad y alta concurrencia.',
    descEn: 'I design and build cloud architectures, SaaS platforms, and high-performance APIs engineered for stability and high concurrency.',
    features: [
      // { es: 'Arquitectura SaaS y multi-inquilino (Multi-tenant)', en: 'Multi-tenant SaaS Architecture' },
