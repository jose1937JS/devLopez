      { es: 'Conexión bidireccional vía Webhooks con ERPs y herramientas de terceros', en: 'Two-way webhook integrations with ERPs & third-party software' },
      { es: 'APIs RESTful y GraphQL estructuradas y seguras', en: 'Structured & Secure RESTful/GraphQL APIs' },
      { es: 'Autenticación avanzada (OAuth2, JWT, RBAC)', en: 'Advanced Authentication (OAuth2, JWT, RBAC)' },
      { es: 'Pasarelas de pago y suscripciones (Stripe, PayPal)', en: 'Payment Gateways & Subscriptions (Stripe, PayPal)' },
      { es: 'Integración de modelos LLM e Inteligencia Artificial', en: 'LLM & Artificial Intelligence Integration' },
      { es: 'Infraestructura Cloud, Docker y despliegue CI/CD', en: 'Cloud Infrastructure, Docker & CI/CD Pipelines' },
      { es: 'Diseño de base de datos relacional y cache en memoria', en: 'Relational Database Design & In-Memory Caching' },
    ],
    color: 'from-primary-500/20 to-primary-700/10',
    accent: 'border-primary-500/30',
  },
  {
    id: 'mobile',
    iconEs: 'Apps Móviles',
    iconEn: 'Mobile Apps',
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>`,
    titleEs: 'Aplicaciones Móviles Multiplataforma',
    titleEn: 'Cross-Platform Mobile Apps',
    descEs: 'Desarrollo aplicaciones móviles para iOS y Android compartiendo una base de código única, logrando rendimiento nativo y tiempos de entrega reducidos.',
    descEn: 'I build mobile applications for iOS and Android with a unified codebase, delivering native performance and accelerated release cycles.',
    features: [
      { es: 'Código único para iOS y Android con rendimiento nativo', en: 'Single codebase for iOS & Android with native performance' },
      { es: 'Publicación completa en App Store y Google Play', en: 'End-to-end App Store & Google Play Publishing' },
      { es: 'Suscripciones y compras dentro de la app (In-App Purchases)', en: 'Subscriptions & In-App Purchases (RevenueCat / Stripe)' },
      { es: 'Arquitectura offline-first y sincronización en tiempo real', en: 'Offline-first Architecture & Real-Time Sync' },
      { es: 'Notificaciones push segmentadas y analítica de eventos', en: 'Segmented Push Notifications & Event Analytics' },
      { es: 'Interfaces bajo estándares Human Interface y Material Design', en: 'UI built to Human Interface & Material Design Standards' },
      { es: 'Monitoreo de estabilidad y reporte de errores en vivo', en: 'Real-time Crash Reporting & Stability Monitoring' },
      { es: 'Seguridad OWASP Mobile Top 10', en: 'OWASP Mobile Top 10 Security' },
    ],
    color: 'from-amber-DEFAULT/20 to-amber-DEFAULT/5',
    accent: 'border-amber-DEFAULT/30',
  },
  {
    id: 'web',
    iconEs: 'Web & Landing Pages',
    iconEn: 'Web & Landing Pages',
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>`,
