---
// Services.astro — Interactive tab-based service grid
const services = [
  {
    id: 'software',
    iconEs: 'Software a Medida',
    iconEn: 'Custom Software',
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
    titleEs: 'Software a Medida',
    titleEn: 'Custom Software',
    descEs: 'Desarrollamos APIs robustas, plataformas SaaS escalables y arquitecturas cloud diseñadas para manejar millones de usuarios.',
    descEn: 'We build robust APIs, scalable SaaS platforms and cloud architectures designed to handle millions of users.',
    features: [
      { es: 'APIs RESTful', en: 'RESTful APIs' },
      { es: 'Plataformas SaaS multi-tenant', en: 'Multi-tenant SaaS Platforms' },
      { es: 'Arquitecturas microservicios', en: 'Microservices Architecture' },
      { es: 'Integración de pagos (Stripe, PayPal, etc)', en: 'Payment Integration (Stripe, PayPal, etc)' },
      { es: 'Sistemas de autenticación OAuth2/JWT', en: 'OAuth2/JWT Authentication' },
      { es: 'CI/CD y DevOps en AWS/GCP', en: 'CI/CD & DevOps on AWS/GCP' },
      { es: 'Integración con IA (OpenAI, Claude, Gemini, etc)', en: 'AI Integration (OpenAI, Claude, Gemini, etc)' },
      { es: 'Diseño UX/UI profesional', en: 'Professional UX/UI Design' }
      
    ],
    stack: ['Node.js', 'Laravel', 'Nest.js', 'Express.js', 'PHP', 'PostgreSQL', 'Redis', 'AWS'],
    color: 'from-primary-500/20 to-primary-700/10',
    accent: 'border-primary-500/30',
  },
  {
    id: 'mobile',
    iconEs: 'Apps Móviles',
    iconEn: 'Mobile Apps',
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>`,
    titleEs: 'Apps Móviles Multiplataforma',
    titleEn: 'Cross-platform Mobile Apps',
    descEs: 'Experiencias multiplataforma con una sola base de código. Con React Native la construccion de apps se hacen en tiempo récord.',
    descEn: 'Cross-platform experiences with a single codebase. With React Native, app development is done in record time.',
    features: [
      { es: 'React Native (iOS + Android)', en: 'React Native (iOS + Android)' },
      { es: 'Publicación en App Store & Play Store', en: 'App Store & Play Store publishing' },
      { es: 'Push notifications, offline-first', en: 'Push notifications, offline-first' },
      { es: 'Analytics & crash reporting', en: 'Analytics & crash reporting' },
      { es: 'Integración con IA (OpenAI, Claude, Gemini, etc)', en: 'AI Integration (OpenAI, Claude, Gemini, etc)' },
      { es: 'Diseño UX/UI profesional', en: 'Professional UX/UI Design' },
      { es: 'Integración con Stripe, PayPal, etc', en: 'Integration with Stripe, PayPal, etc' },
    ],
    stack: ['React Native', 'Expo', 'Swift', 'Kotlin', 'Firebase', 'RevenueCat'],
    color: 'from-amber-DEFAULT/20 to-amber-DEFAULT/5',
    accent: 'border-amber-DEFAULT/30',
  },
  {
    id: 'web',
    iconEs: 'Web & Landing Pages',
    iconEn: 'Web & Landing Pages',
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>`,
    titleEs: 'Páginas Web & Landing Pages',
    titleEn: 'Web & Landing Pages',
    descEs: 'Sitios ultra-rápidos con Astro y Next.js optimizados para Core Web Vitals, conversión y posicionamiento SEO.',
    descEn: 'Ultra-fast sites with Astro and Next.js optimized for Core Web Vitals, conversion and SEO ranking.',
    features: [
      { es: 'Astro & Next.js App Router', en: 'Astro & Next.js App Router' },
      { es: 'Lighthouse 99+ en todas las métricas', en: 'Lighthouse 99+ on all metrics' },
      { es: 'SEO técnico avanzado con Indexación en Google', en: 'Advanced technical SEO with Google Indexation' },
      { es: 'E-commerce personalizados', en: 'Custom E-commerce' },
      { es: 'Animaciones GSAP & microinteracciones', en: 'GSAP animations & micro-interactions' },
      { es: 'Optimización de velocidad y rendimiento', en: 'Speed and Performance Optimization' },
    ],
    stack: ['Astro', 'Next.js', 'TypeScript', 'Tailwind', 'Vercel', 'Cloudflare'],
    color: 'from-red-500/15 to-red-700/5',
    accent: 'border-red-500/30',
  },
];
---

<section id="services" class="relative py-24 lg:py-32 overflow-hidden">
  <!-- BG glow -->
  <div class="absolute top-1/2 right-0 w-96 h-96 rounded-full opacity-[0.05] blur-3xl translate-x-1/2" style="background: #ff6b26;" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <div class="reveal flex items-center gap-3 justify-center mb-4">
        <div class="h-px w-12 bg-primary-500/40"></div>
        <span class="text-xs font-semibold uppercase tracking-widest text-primary-500" data-es="Nuestros Servicios" data-en="Our Services">Nuestros Servicios</span>
        <div class="h-px w-12 bg-primary-500/40"></div>
      </div>
      <h2 class="reveal stagger-1 font-black text-3xl sm:text-4xl lg:text-5xl text-white mb-4 leading-tight">
        <span data-es="Soluciones digitales" data-en="Digital solutions">Soluciones digitales</span>
        <br />
        <span class="text-gradient" style="background: linear-gradient(135deg, #ff6b26, #f59e0b); background-size:200%; -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">
          <span data-es="a medida para tu negocio" data-en="tailored for your business">a medida para tu negocio</span>
        </span>
      </h2>
      <p class="reveal stagger-2 text-base-400 text-lg max-w-2xl mx-auto"
        data-es="Desde una landing page que convierte hasta una app móvil con su plataforma completa, tenemos los conocimientos para llevar tu idea al siguiente nivel."
        data-en="From a converting landing page to a mobile app with its complete platform, we have the knowledge to take your idea to the next level."
      >
        Desde una landing page que convierte hasta una app móvil con su plataforma completa, tenemos los conocimientos para llevar tu idea al siguiente nivel.
      </p>
    </div>

    <!-- Section image -->
    <!-- <div class="reveal flex justify-center mb-12">
      <div class="relative max-w-sm">
        <div class="absolute inset-0 rounded-2xl blur-2xl opacity-20" style="background: radial-gradient(circle, #ff6b26, #f59e0b);" aria-hidden="true"></div>
        <img src="/images/services.jpg" alt="Services illustration" class="section-img relative z-10 w-full rounded-2xl border border-white/5" loading="lazy" />
      </div>
    </div> -->

    <!-- Tabs -->
    <div class="reveal stagger-2">
      <!-- Tab buttons -->
      <div class="flex flex-wrap gap-2 justify-center mb-8" id="service-tabs" role="tablist">
        {services.map((s, i) => (
          <button
            class={`tab-btn flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 ${i === 0 ? 'bg-primary-500 text-white' : 'glass text-base-300 hover:text-white'}`}
            data-tab={s.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <Fragment set:html={s.icon} />
            <span data-es={s.iconEs} data-en={s.iconEn}>{s.iconEs}</span>
          </button>
        ))}
      </div>

      <!-- Tab panels -->
      {services.map((s, i) => (
        <div
          class={`tab-panel ${i === 0 ? 'active' : ''}`}
          id={`panel-${s.id}`}
          role="tabpanel"
        >
          <div class={`spotlight-card glass rounded-3xl p-6 lg:p-10 border ${s.accent} bg-gradient-to-br ${s.color}`}>
            <div class="grid lg:grid-cols-2 gap-8 items-start">
              <!-- Left -->
              <div>
                <h3 class="font-black text-2xl lg:text-3xl text-white mb-3" data-es={s.titleEs} data-en={s.titleEn}>{s.titleEs}</h3>
                <p class="text-base-300 mb-6 leading-relaxed" data-es={s.descEs} data-en={s.descEn}>{s.descEs}</p>
                <a
                  href="#contact"
                  class="btn-magnetic inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary-500 hover:bg-primary-400 text-white font-semibold text-sm transition-all duration-200 w-fit"
                >
                  <span data-es="Solicitar Cotización" data-en="Request a Quote">Solicitar Cotización</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
                
              </div>

              <!-- Right: Stack + CTA -->
              <div class="flex flex-col gap-6">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-widest text-base-400 mb-3" data-es="Conoce más de lo que puedo hacer y más" data-en="Know more about what I can do and more">Conoce más de lo que puedo hacer y más</p>
                  {/* <div class="flex flex-wrap gap-2">
                    {s.stack.map((tech) => (
                      <span class="px-3 py-1 rounded-lg glass text-xs font-mono font-semibold text-base-200 border border-white/5">
                        {tech}
                      </span>
                    ))}
                  </div> */}
                </div>
                <!-- Features -->
                <ul class="grid sm:grid-cols-2 gap-2">
                  {s.features.map((f) => (
                    <li class="flex items-start gap-2 text-sm text-base-300">
                      <svg class="w-4 h-4 text-primary-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      <span data-es={f.es} data-en={f.en}>{f.es}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('.tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;
      // Update buttons
      document.querySelectorAll('.tab-btn').forEach((b) => {
        const active = b.dataset.tab === tab;
        b.classList.toggle('bg-primary-500', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('glass', !active);
        b.classList.toggle('text-base-300', !active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      // Update panels
      document.querySelectorAll('.tab-panel').forEach((p) => {
        p.classList.toggle('active', p.id === `panel-${tab}`);
      });
    });
  });
</script>
