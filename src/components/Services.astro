    descEs: 'Sitios web ultra-optimizados, desarrollados para cargar de forma instantánea, posicionar en motores de búsqueda y maximizar la tasa de conversión.',
    descEn: 'Ultra-optimized websites built for instant loading, top search engine visibility, and maximum conversion rates.',
    features: [
      { es: 'Rendimiento Core Web Vitals y puntuación Lighthouse 95+', en: 'Core Web Vitals & Lighthouse 95+ Performance' },
      { es: 'SEO técnico avanzado, OpenGraph y datos estructurados (Schema)', en: 'Advanced Technical SEO, OpenGraph & Structured Data (Schema)' },
      { es: 'Diseño responsive enfocado en experiencia móvil (Mobile-First)', en: 'Mobile-First Responsive Design & Frictionless UX' },
      { es: 'Animaciones fluidas con microinteracciones y scroll interactivo', en: 'Fluid Animations, Micro-interactions & Scroll Triggers' },
      // { es: 'Integración con CRM, analítica de funnels y formularios dinámicos', en: 'CRM Integration, Funnel Analytics & Dynamic Forms' },
      { es: 'Panel autoadministrable para editar textos, blogs y productos sin programar', en: 'Headless CMS setup to update text, blogs & products code-free' },
