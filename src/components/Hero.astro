---
// Hero.astro — Cinematic hero with canvas particle mesh + animated headline + dual CTAs
---

<section
  id="hero"
  class="sticky top-0 h-screen flex items-center overflow-hidden bg-base-mesh z-0"
  style="background: radial-gradient(ellipse 100% 80% at 50% -10%, rgba(255,107,38,0.12) 0%, transparent 80%), radial-gradient(ellipse 60% 60% at 80% 90%, rgba(245,158,11,0.06) 0%, transparent 70%), #0a0a0c;"
>
  <!-- Canvas particle mesh -->
  <canvas
    id="hero-canvas"
    class="absolute inset-0 w-full h-full opacity-40"
    aria-hidden="true"
  ></canvas>

  <!-- Grid overlay -->
  <div
    class="absolute inset-0 opacity-[0.03]"
    style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 80px 80px;"
    aria-hidden="true"
  ></div>

  <div id="hero-content" class="relative z-100 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-24 pb-16">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Copy -->
      <div class="flex flex-col gap-6">
        <!-- Badge -->
        <!-- <div class="reveal inline-flex items-center gap-2 w-fit px-3.5 py-1.5 rounded-full glass border border-primary-500/20 text-xs font-semibold text-primary-400 uppercase tracking-widest">
          <span class="w-1.5 h-1.5 rounded-full bg-primary-500 animate-pulse"></span>
          <span data-es="Estudio Premium de Software" data-en="Premium Software Studio">Estudio Premium de Software</span>
        </div> -->

        <!-- Headline -->
        <h1 class="reveal stagger-1 font-black leading-[1.05] tracking-tight">
          <span class="block text-4xl sm:text-5xl lg:text-6xl xl:text-7xl text-white dark:text-white text-base-900">
            <span data-es="Construimos" data-en="We Build">Construimos</span>
          </span>
          <span
            class="block text-4xl sm:text-5xl lg:text-6xl xl:text-7xl text-gradient mt-1"
            style="background: linear-gradient(135deg, #ff6b26 0%, #f59e0b 40%, #ef4444 80%, #ff6b26 100%); background-size: 300% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: gradientX 4s ease infinite;"
          >
            <span data-es="Software que" data-en="Software that">Software que</span>
          </span>
          <span class="block text-4xl sm:text-5xl lg:text-6xl xl:text-7xl text-white dark:text-white">
            <span data-es="Escala y Convierte" data-en="Scales & Converts">Escala y Convierte</span>
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="reveal stagger-2 text-base-300 text-lg sm:text-xl leading-relaxed max-w-xl">
          <span 
            data-es="Aplicaciones móviles iOS/Android, agentes de IA, y sitios web de alto rendimiento diseñados para convertir visitantes en clientes." 
            data-en="Mobile applications iOS/Android, AI agents, and high-performance websites designed to convert visitors into customers."
          >
            Aplicaciones móviles iOS/Android, agentes de IA, y sitios web de alto rendimiento diseñados para convertir visitantes en clientes.
          </span>
        </p>

        <!-- CTAs -->
        <div class="reveal stagger-3 flex flex-wrap gap-3">
          <a
            href="#contact"
            class="btn-magnetic group inline-flex items-center gap-2.5 px-6 py-3.5 rounded-2xl bg-primary-500 hover:bg-primary-400 text-white font-semibold text-base transition-all duration-300 glow-primary-sm hover:glow-primary"
          >
            <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span data-es="Cotizar Proyecto" data-en="Get a Quote">Cotizar Proyecto</span>
          </a>
          <a
            href="#portfolio"
            class="btn-magnetic group inline-flex items-center gap-2.5 px-6 py-3.5 rounded-2xl glass glass-hover text-white font-semibold text-base transition-all duration-300"
          >
            <span data-es="Ver Portafolio" data-en="View Portfolio">Ver Portafolio</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <!-- Trust signals -->
        <!-- <div class="reveal stagger-4 flex items-center gap-6 pt-2">
          <div class="flex -space-x-2">
            {['🟠', '🔵', '🟢', '🟡'].map((c, i) => (
              <div class={`w-8 h-8 rounded-full glass border border-white/10 flex items-center justify-center text-sm stagger-${i + 1}`}>
                {c}
              </div>
            ))}
          </div>
          <p class="text-sm text-base-400">
            <span class="text-white font-semibold">+50 </span>
            <span data-es="proyectos entregados" data-en="projects delivered">proyectos entregados</span>
          </p>
        </div> -->
      </div>

      <!-- Right: Hero Image -->
      <div class="relative flex items-center justify-center">
        <!-- Glow blob -->
        <div
          class="absolute inset-0 rounded-full blur-3xl opacity-20"
          style="background: radial-gradient(circle, #ff6b26 0%, #f59e0b 50%, transparent 70%);"
          aria-hidden="true"
        ></div>
        <!-- Image Animation Canvas -->
        <!-- <canvas
          id="hero-video-canvas"
          width="1280"
          height="720"
          class="section-img relative scale-150 z-10 w-full max-w-xl lg:max-w-2xl rounded-2xl"
          style="animation: float 6s ease-in-out infinite;"
        ></canvas> -->
        <img
          id="hero-image"
          src="/images/hero4.png"
          alt="Hero"
          class="section-img relative scale-160 translate-x-20 w-full max-w-xl lg:max-w-2xl rounded-2xl"
        />
        <!-- Floating badges -->
        <!-- <div class="absolute top-8 -left-4 glass rounded-xl px-3 py-2 text-xs font-semibold text-primary-400 border border-primary-500/20 animate-bounce-subtle hidden sm:block">
          <span class="text-white font-bold">99</span> Lighthouse Score
        </div>
        <div class="absolute bottom-12 -right-4 glass rounded-xl px-3 py-2 text-xs font-semibold text-amber-glow border border-amber-DEFAULT/20 animate-bounce-subtle hidden sm:block" style="animation-delay: 0.5s;">
          React Native · iOS · Android
        </div> -->
      </div>
    </div>

    <!-- Scroll indicator -->
    <!-- <div class="reveal stagger-5 absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-base-400">
      <span class="text-xs uppercase tracking-widest" data-es="Explorar" data-en="Explore">Explorar</span>
      <div class="w-px h-10 bg-gradient-to-b from-primary-500/50 to-transparent animate-bounce-subtle"></div>
    </div> -->
  </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
